{
  "name": "markdown-deck",
  "version": "0.6.6",
  "description": "Render tagged sections of a Markdown document into HTML slides and a PDF, keeping the Markdown as the only source.",
  "author": "Dermot O'Brien",
  "homepage": "https://github.com/dermot-obrien/markdown-deck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dermot-obrien/markdown-deck.git",
    "directory": "skills/markdown-deck"
  },
  "bugs": "https://github.com/dermot-obrien/markdown-deck/issues",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "markdown-deck": "bin/markdown-deck.mjs"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./parse": "./src/parse.mjs",
    "./render": "./src/render.mjs"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "LICENSE",
    "bin/",
    "src/",
    "themes/",
    "examples/",
    "inputs.toml",
    "NOTICE",
    "LICENSES/"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^16.4.2"
  },
  "optionalDependencies": {
    "playwright": "^1.61.1"
  },
  "peerDependencies": {
    "pdf-lib": "^1.17.1"
  },
  "peerDependenciesMeta": {
    "pdf-lib": {
      "optional": true
    }
  },
  "scripts": {
    "example": "node bin/markdown-deck.mjs build examples/example.md --out .tmp/example --theme default",
    "test": "node tests/run.mjs"
  },
  "keywords": [
    "markdown",
    "slides",
    "deck",
    "pdf",
    "agent-skill"
  ]
}
